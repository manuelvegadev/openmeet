{
  "name": "openmeet-terminal",
  "version": "0.4.1",
  "description": "Join OpenMeet video rooms from the terminal — audio chat and text messaging via WebRTC",
  "type": "module",
  "bin": {
    "openmeet": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "windows/"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx --server ws://localhost:3001/ws",
    "start": "tsx src/index.tsx",
    "build": "node build.mjs",
    "build:tsc": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "node build.mjs"
  },
  "keywords": [
    "webrtc",
    "video-conferencing",
    "terminal",
    "cli",
    "audio-chat",
    "openmeet"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@roamhq/wrtc": "^0.10.0",
    "audify": "^1.10.1",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@openmeet/shared": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/ws": "^8",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
